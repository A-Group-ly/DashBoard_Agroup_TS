# Copy this file to `.env` (used by Vite) AND to `.dev.vars` (used by Wrangler):
#   cp .env.example .env && cp .env.example .dev.vars
# Never commit the real files. In production these live in Cloudflare
# (worker secrets) and GitHub (Actions secrets), not in the code.

# --- Frontend (optional) ---
# Only needed for `npm run dev`. In production the page reads the key from the
# worker's CLERK_PUBLISHABLE_KEY via /api/config, so CI does not need it.
# Clerk dashboard -> Configure -> API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Worker / API (server-side) ---
# Neon dashboard -> your project -> Connect -> connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Same publishable key as above; the worker derives Clerk's public key URL from it
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk dashboard -> Configure -> API keys -> Secret keys (keep private!)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated emails that are always Super admins (recommended: your own)
ADMIN_EMAILS=you@example.com

# Local development only: the Vite dev server origin that requests tokens
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Optional: PEM public key (Clerk -> API keys -> "JWKS Public Key") to verify
# sessions without fetching Clerk's JWKS. Leave empty to use the JWKS URL.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional: time zone used for "this month" / "this week" (default Africa/Tripoli)
# COMPANY_TIME_ZONE=Africa/Tripoli
