
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Currency {
  LYD
  USD
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CASH
  LOCAL_BANK_CARD
  INTERNATIONAL_CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayableStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum UserRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
}

model Company {
  id         String   @id @default(cuid()) @db.VarChar(30)
  name       String   @db.VarChar(191)
  contactName String? @map("contact_name") @db.VarChar(191)
  email      String?  @db.VarChar(191)
  phone      String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions Subscription[]

  @@index([name])
  @@map("companies")
}

model Plan {
  id             String          @id @default(cuid()) @db.VarChar(30)
  name           String          @unique @db.VarChar(191)
  description    String?         @db.Text
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  priceLYD       Decimal?        @map("price_lyd") @db.Decimal(15, 2)
  priceUSD       Decimal?        @map("price_usd") @db.Decimal(15, 2)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(cuid()) @db.VarChar(30)
  companyId String             @map("company_id") @db.VarChar(30)
  planId    String             @map("plan_id") @db.VarChar(30)
  amount    Decimal            @db.Decimal(15, 2)
  currency  Currency
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?          @map("starts_at") @db.DateTime(3)
  expiresAt DateTime?          @map("expires_at") @db.DateTime(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([createdAt, status])
  @@index([companyId])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(cuid()) @db.VarChar(30)
  subscriptionId    String        @map("subscription_id") @db.VarChar(30)
  amount            Decimal       @db.Decimal(15, 2)
  currency          Currency
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  providerReference String?       @unique @map("provider_reference") @db.VarChar(191)
  paidAt            DateTime?     @map("paid_at") @db.DateTime(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([status, paidAt])
  @@index([currency, paidAt])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid()) @db.VarChar(30)
  title       String   @db.VarChar(191)
  description String?  @db.Text
  amount      Decimal  @db.Decimal(15, 2)
  currency    Currency
  expenseDate DateTime @default(now()) @map("expense_date") @db.DateTime(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([currency, expenseDate])
  @@map("expenses")
}

model Payable {
  id          String        @id @default(cuid()) @db.VarChar(30)
  vendorName  String        @map("vendor_name") @db.VarChar(191)
  description String?       @db.Text
  amount      Decimal       @db.Decimal(15, 2)
  amountPaid  Decimal       @default(0.00) @map("amount_paid") @db.Decimal(15, 2)
  currency    Currency
  status      PayableStatus @default(UNPAID)
  dueDate     DateTime?     @map("due_date") @db.DateTime(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, currency])
  @@map("payables")
}

model AdminUser {
  id           String   @id @default(cuid()) @db.VarChar(30)
  fullName     String   @map("full_name") @db.VarChar(191)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(SUPPORT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("admin_users")
}
